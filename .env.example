# Clave de Gemini: cópiala en .env y nunca la incluyas en el código.
GOOGLE_API_KEY=
# Modelo de Gemini que usarán los agentes.
MODELO=gemini-3.5-flash-lite
# Dirección donde escuchará el agente de viajes.
URL_VIAJES=http://127.0.0.1:8080
# Dirección donde escuchará el agente de restaurantes.
URL_RESTAURANTES=http://127.0.0.1:8001
# Dirección donde escuchará el agente coordinador.
URL_COORDINADOR=http://127.0.0.1:8002
# Dirección local donde escuchará agente_meteorologo.
URL_NOMBRE=http://127.0.0.1:8003
# Dirección HTTPS pública del túnel Cloudflare del agente que vas a compartir.
URL_PUBLICA=
# Direcciones HTTPS de Agent Cards de compañeros, separadas por comas.
URLS_AGENTES=
